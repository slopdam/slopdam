{
  "name": "@slopdam/core",
  "version": "0.5.0",
  "description": "Strip AI-generated traces (em dashes, emoji, separators, markdown) from log messages, with pino, winston and ESLint integrations. JavaScript port of slopdam, conformance-tested against its spec.",
  "license": "MIT",
  "author": "The slopdam Authors",
  "homepage": "https://github.com/slopdam/slopdam/tree/main/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slopdam/slopdam.git",
    "directory": "js"
  },
  "bugs": "https://github.com/slopdam/slopdam/issues",
  "keywords": [
    "logging",
    "linter",
    "formatter",
    "korean",
    "ai",
    "slop",
    "llm",
    "em-dash",
    "emoji",
    "pino",
    "winston",
    "eslint",
    "eslintplugin"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./pino": {
      "import": {
        "types": "./dist/esm/pino.d.ts",
        "default": "./dist/esm/pino.js"
      },
      "require": {
        "types": "./dist/cjs/pino.d.ts",
        "default": "./dist/cjs/pino.js"
      }
    },
    "./winston": {
      "import": {
        "types": "./dist/esm/winston.d.ts",
        "default": "./dist/esm/winston.js"
      },
      "require": {
        "types": "./dist/cjs/winston.d.ts",
        "default": "./dist/cjs/winston.js"
      }
    },
    "./eslint": {
      "import": {
        "types": "./dist/esm/eslint.d.ts",
        "default": "./dist/esm/eslint.js"
      },
      "require": {
        "types": "./dist/cjs/eslint.d.ts",
        "default": "./dist/cjs/eslint.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "pino": "^10.4.0",
    "typescript": "~6.0.3",
    "winston": "^3.19.0"
  }
}

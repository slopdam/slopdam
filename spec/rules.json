{
  "spec_version": 1,
  "profiles": [
    "reader",
    "dev"
  ],
  "levels": [
    "basic",
    "strong",
    "strict"
  ],
  "dash_inline": {
    "comma": ", ",
    "colon": ": ",
    "hyphen": " - ",
    "space": " "
  },
  "default_dash_inline": "colon",
  "protected_spans": "(?P<url>https?://[^\\s<>\\\"'`]+)|`(?P<code>[^`\\n]+)`|(?<=\\w=)(?<!msg=)(?<!message=)(?<!error=)(?P<kv>\\\"[^\\\"\\n]*\\\"|'[^'\\n]*'|[^\\s,;)]+)|(?<![\\w/])(?P<path>(?:~|\\.{1,2})?/[^\\s\\\"'`,;)]+)|(?P<pua>[\\U000F0000-\\U000FFFFD])",
  "charsets": {
    "hyphens": "‐‑−﹣－",
    "dashes": "‒–—―⸺⸻﹘︱︲⹀",
    "hangul_eu": "ㅡￚᅳ",
    "box_lines": "─━┄-┋╌-╏═⎯⏤➖",
    "emoji": "🀀-🫿☀-➿⬀-⯿⌀-⏿■-◿‼⁉ℹ〰〽㊗㊙Ⓜ🇦-🇿󠀠-󠁿️⃣‍",
    "status": {
      "[OK]": "✅✔☑🟢🆗",
      "[FAIL]": "❌✖🔴⛔🚫❎",
      "[WARN]": "⚠🟡🚨"
    },
    "hangul_choseong": "ᄀ-ᅟꥠ-ꥼ",
    "han_kana": "぀-ヿ㐀-䶿一-鿿豈-﫿ｦ-ﾟ"
  },
  "dash_range_after": "[A-Za-z]{1,3}[0-9]",
  "dash_word_before": ")]}%\"'”’",
  "dash_word_after": "([{\"'“‘",
  "tidy": {
    "scope": "changed_lines",
    "multi_space": "(?<=\\S)[ \\t]{2,}",
    "quote_space": "[ \\t]+(?=[\\\"'](?:[\\s,;}\\]]|$))",
    "max_passes": 8
  },
  "status_redundant_at": {
    "[FAIL]": "ERROR",
    "[WARN]": "WARNING"
  },
  "rules": [
    {
      "id": "space.invisible",
      "level": "basic",
      "description": "zero-width or invisible character",
      "pattern": "[​‌⁠﻿­]",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": ""
        },
        "dev": {
          "kind": "replace",
          "value": ""
        }
      }
    },
    {
      "id": "space.nbsp",
      "level": "basic",
      "description": "non-breaking or ideographic space",
      "pattern": "[  　]",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": " "
        },
        "dev": {
          "kind": "replace",
          "value": " "
        }
      }
    },
    {
      "id": "width.fullwidth",
      "level": "basic",
      "description": "full-width punctuation",
      "pattern": "[，：；（）！？［］｛｝]",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "function",
          "name": "fullwidth"
        },
        "dev": {
          "kind": "function",
          "name": "fullwidth"
        }
      }
    },
    {
      "id": "quote.double",
      "level": "basic",
      "description": "curly double quote",
      "pattern": "[“”„]",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "function",
          "name": "quote_double"
        },
        "dev": {
          "kind": "function",
          "name": "quote_double"
        }
      }
    },
    {
      "id": "quote.single",
      "level": "basic",
      "description": "curly single quote",
      "pattern": "[‘’‚]",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": "'"
        },
        "dev": {
          "kind": "replace",
          "value": "'"
        }
      }
    },
    {
      "id": "punct.ellipsis",
      "level": "basic",
      "description": "ellipsis character",
      "pattern": "[…⋯]",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": "..."
        },
        "dev": {
          "kind": "replace",
          "value": "..."
        }
      }
    },
    {
      "id": "punct.arrow",
      "level": "basic",
      "description": "arrow symbol",
      "pattern": "[↔⇔]️?",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": "<->"
        },
        "dev": {
          "kind": "replace",
          "value": "<->"
        }
      }
    },
    {
      "id": "punct.arrow",
      "level": "basic",
      "description": "arrow symbol",
      "pattern": "[→⇒➜➡➔⟶]️?",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": "->"
        },
        "dev": {
          "kind": "replace",
          "value": "->"
        }
      }
    },
    {
      "id": "punct.arrow",
      "level": "basic",
      "description": "arrow symbol",
      "pattern": "[←⇐⬅⟵]️?",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": "<-"
        },
        "dev": {
          "kind": "replace",
          "value": "<-"
        }
      }
    },
    {
      "id": "punct.bullet",
      "level": "basic",
      "description": "bullet symbol",
      "pattern": "^([ \t]*)[•◦▪●▶►][ \t]*",
      "flags": [
        "multiline"
      ],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": "\\1- "
        },
        "dev": {
          "kind": "replace",
          "value": "\\1- "
        }
      }
    },
    {
      "id": "emoji.status",
      "level": "basic",
      "description": "status emoji",
      "pattern": "\\A[ \t]*([✅✔☑🟢🆗❌✖🔴⛔🚫❎⚠🟡🚨])️?[ \t]*",
      "flags": [],
      "actions": {
        "dev": {
          "kind": "function",
          "name": "status_tag"
        }
      }
    },
    {
      "id": "emoji.pictograph",
      "level": "basic",
      "description": "emoji or pictograph",
      "pattern": "[🀀-🫿☀-➿⬀-⯿⌀-⏿■-◿‼⁉ℹ〰〽㊗㊙Ⓜ🇦-🇿󠀠-󠁿][🀀-🫿☀-➿⬀-⯿⌀-⏿■-◿‼⁉ℹ〰〽㊗㊙Ⓜ🇦-🇿󠀠-󠁿️⃣‍]*[ \t]*|[️⃣‍]+",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": ""
        },
        "dev": {
          "kind": "replace",
          "value": ""
        }
      }
    },
    {
      "id": "dash.hyphen",
      "level": "basic",
      "description": "Unicode hyphen or minus",
      "pattern": "[‐‑−﹣－]",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": "-"
        },
        "dev": {
          "kind": "replace",
          "value": "-"
        }
      }
    },
    {
      "id": "dash.wave",
      "level": "basic",
      "description": "wave dash or full-width tilde",
      "pattern": "[〜～]",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": "~"
        },
        "dev": {
          "kind": "replace",
          "value": "~"
        }
      }
    },
    {
      "id": "md.heading",
      "level": "basic",
      "description": "markdown heading marker",
      "pattern": "^[ \\t]*#{1,6}[ \\t]+",
      "flags": [
        "multiline"
      ],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": ""
        },
        "dev": {
          "kind": "replace",
          "value": ""
        }
      }
    },
    {
      "id": "md.fence",
      "level": "basic",
      "description": "markdown code fence",
      "pattern": "^[ \\t]*```[^\\n]*",
      "flags": [
        "multiline"
      ],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": ""
        },
        "dev": {
          "kind": "replace",
          "value": ""
        }
      }
    },
    {
      "id": "md.hr",
      "level": "basic",
      "description": "markdown horizontal rule",
      "pattern": "^[ \\t]*([-*_])[ \\t]*(?:\\1[ \\t]*){2,}$",
      "flags": [
        "multiline"
      ],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": ""
        },
        "dev": {
          "kind": "replace",
          "value": ""
        }
      }
    },
    {
      "id": "md.emphasis",
      "level": "basic",
      "description": "markdown bold",
      "pattern": "\\*\\*(.+?)\\*\\*",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "function",
          "name": "unwrap"
        },
        "dev": {
          "kind": "function",
          "name": "unwrap"
        }
      }
    },
    {
      "id": "dash.run",
      "level": "basic",
      "description": "dash, 'ㅡ' or line character",
      "pattern": "([ \t]*)(?<![+|│┃║┆┇┊┋┌┐└┘├┤┬┴┼╔╗╚╝╠╣╦╩╬╒╓╕╖╘╙╛╜╞╟╡╢╤╥╧╨╪╫╭╮╯╰‒–—―⸺⸻﹘︱︲⹀ㅡￚᅳ─━┄-┋╌-╏═⎯⏤➖])([‒–—―⸺⸻﹘︱︲⹀ㅡￚᅳ─━┄-┋╌-╏═⎯⏤➖]+)(?![+|│┃║┆┇┊┋┌┐└┘├┤┬┴┼╔╗╚╝╠╣╦╩╬╒╓╕╖╘╙╛╜╞╟╡╢╤╥╧╨╪╫╭╮╯╰‒–—―⸺⸻﹘︱︲⹀ㅡￚᅳ─━┄-┋╌-╏═⎯⏤➖])([ \t]*)",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "function",
          "name": "dash_run"
        },
        "dev": {
          "kind": "function",
          "name": "dash_run"
        }
      }
    },
    {
      "id": "dash.cjk-run",
      "level": "basic",
      "description": "CJK look-alike separator",
      "pattern": "[一ーｰ]{3,}",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": ""
        },
        "dev": {
          "kind": "replace",
          "value": ""
        }
      }
    },
    {
      "id": "dash.ascii-run",
      "level": "basic",
      "description": "ASCII separator",
      "pattern": "(?<![=\\-*#~_+|])([=\\-*#~_+])\\1{4,}(?![=\\-*#~_+|])",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": ""
        },
        "dev": {
          "kind": "replace",
          "value": ""
        }
      }
    },
    {
      "id": "tone.exclaim",
      "level": "basic",
      "description": "exclamation after Korean text",
      "pattern": "(?<=[가-힣])!+",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": "."
        }
      }
    },
    {
      "id": "tone.filler",
      "level": "strong",
      "description": "filler phrase",
      "pattern": "(?:성공적으로|완벽하게|무사히|드디어)[ \\t]*",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "replace",
          "value": ""
        },
        "dev": {
          "kind": "report"
        }
      }
    },
    {
      "id": "tone.chatty",
      "level": "strong",
      "description": "chatty opener",
      "pattern": "^([ \\t]*(?:\\[(?:OK|FAIL|WARN)\\][ \\t]+)?(?:[-*+][ \\t]+|#{1,6}[ \\t]+|\\d+[.)][ \\t]+)?)(?:Great news!|Great news:|Good news!|Good news:|Heads up:|Heads up,|Heads-up:|Just so you know,|Just a heads up:|Quick update:|Status update:|Here's the summary:|Here's a summary:|Here is the summary:|Here's a quick summary:|Here's what happened:|Here is what happened:|Here you go:|Here we go:|Let's go!|Let's see:|Voila!|Voilà!|TL;DR:|TL;DR,|FYI:|FYI,|Hooray!|Yay!|Woohoo!|Huzzah!|Whew!|Phew!|Phew,|Great job!|Nice one!|Awesome!|Fantastic!|Excellent!|Wonderful!|Brilliant!|Good catch!|Guess what\\?|Ta-da!|살펴보겠습니다\\.|해볼게요\\.|해보겠습니다\\.|좋은 소식입니다[!.]+|기쁜 소식입니다[!.]+|좋은 소식이 있습니다[!.]+|알려드립니다:|알려 드립니다:|짜잔[!.]+|잘 됐네요[!.]+|잘됐네요[!.]+|멋지네요[!.]+|요약하자면,|정리하자면,|다행스럽게도(?=[ \t])|보시다시피(?=[ \t])|확인해 보니(?=[ \t])|확인해보니(?=[ \t])|さて、|お知らせです[：:]|良いニュースです[！!]|朗報です[！!]|まとめると、|結論から言うと、|ご覧の通り、|というわけで、|簡単に言うと、|お待たせしました[！!]|好消息[！!]|总结一下[：:]|简单来说[，,]|如你所见[，,]|顺便说一下[，,]|综上所述[，,]|汇报一下[：:]|让我们看看。|我来试试。)[ \\t]*(?=\\S)((?=[a-z]*[aeiouy])[a-z]+(?![\\w.\\-/:@]))?",
      "flags": [
        "multiline"
      ],
      "actions": {
        "reader": {
          "kind": "function",
          "name": "opener"
        },
        "dev": {
          "kind": "function",
          "name": "opener"
        }
      }
    },
    {
      "id": "tone.chatty",
      "level": "basic",
      "description": "chatty phrase",
      "pattern": "\\b(?:Let's|Here's|Voila|Awesome)\\b|해볼게요|해보겠습니다|살펴보겠습니다",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "report"
        },
        "dev": {
          "kind": "report"
        }
      }
    },
    {
      "id": "symbol.non-ascii",
      "level": "strict",
      "description": "non-ASCII symbol",
      "pattern": "[^\\w\\s\u0000-󰀀-󿿽]",
      "flags": [],
      "actions": {
        "reader": {
          "kind": "report"
        },
        "dev": {
          "kind": "report"
        }
      }
    }
  ]
}
